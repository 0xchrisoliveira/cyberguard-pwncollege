def packet_emitter(stop_event, secret_token):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    payload = f"CYBERGUARD_SNIFF_SECRET={secret_token}".encode("utf-8")
    while not stop_event.is_set():
        try:
            sock.sendto(payload, ("127.0.0.1", 44444))
        except Exception:
            pass
        time.sleep(0.8)
    sock.close()

