if resp == "tcpdump_mestre_2026":
    print("[+] Captura realizada com sucesso!")
    print(open("/flag").read() if os.path.exists("/flag") else "pwn.college{cyberguard_demo_flag}")
else:
    print("[X] Token incorreto.")
