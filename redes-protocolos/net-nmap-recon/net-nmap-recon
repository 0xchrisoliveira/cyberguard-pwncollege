   Passo 3: Conecte-se à porta aberta com netcat ou curl para extrair a flag:
            $ nc 127.0.0.1 8085
            ou faça um scan com detecção de versão:
            $ nmap -sV -p 8085 127.0.0.1
""")
    print("=" * 80)

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help"):
        show_lesson("Manual de ajuda solicitado pelo operador.")
        sys.exit(0)

    target_port = 8085
    host = "127.0.0.1"

    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

    try:
        server.bind((host, target_port))
        server.listen(2)
        server.settimeout(120.0)
    except Exception as e:
        show_lesson(f"Não foi possível abrir o socket na porta {target_port}: {e}")
        sys.exit(1)

    print(BANNER)
    print("=" * 80)
    print("   OPERAÇÃO TARGET RECON — SERVIÇO ALVO ATIVO PARA VARREDURA")
    print("=" * 80)
    print(f"[*] Um serviço alvo da Cyberguard foi implantado em uma porta oculta.")
    print(f"[*] Faixa operacional de portas: 8080 até 8090 (Endereço: {host}).")
    print("[*] STATUS: Aguardando varredura e conexão do operador...")
    print("-" * 80)
    print("[*] COMANDO RECOMENDADO EM OUTRO TERMINAL:")
    print("    nmap -p 8080-8090 127.0.0.1")
    print("    Depois, conecte-se à porta encontrada: nc 127.0.0.1 <porta_aberta>")
    print("=" * 80)

    try:
        conn, addr = server.accept()
        print(f"\n[+] Alvo localizado! Conexão originada de {addr[0]}:{addr[1]}")
        flag = print_flag()
        payload = (
            "\n"
            "╔══════════════════════════════════════════════════════════════════════╗\n"
            "║        CYBERGUARD RECONNAISSANCE TARGET — RECON CONCLUÍDO            ║\n"
            "╚══════════════════════════════════════════════════════════════════════╝\n"
            f"[+] PORTA IDENTIFICADA COM SUCESSO: {target_port}/TCP\n"
            "[*] DEBRIEFING TÉCNICO:\n"
            "    Você utilizou técnicas de varredura metódica com Nmap para mapear\n"
            "    a superfície de ataque e descobrir portas não padronizadas.\n"
            "    Em cenários corporativos, administradores frequentemente escondem\n"
            "    interfaces de administração em portas altas na esperança ilusória\n"
            "    de segurança por obscuridade (Security through Obscurity).\n\n"
            f"[+] FLAG DE ACESSO AUTORIZADO:\n{flag}\n\n"
        )
        conn.sendall(payload.encode("utf-8"))
        conn.close()

        print("[+] Reconhecimento validado com sucesso!")
        print(f"[*] Flag entregue ao cliente remoto na porta {target_port}.")
        print(f"[+] FLAG LOCAL:\n{flag}")

    except socket.timeout:
        print("\n[-] TEMPO LIMITE ESGOTADO: Nenhuma conexão recebida em 120 segundos.")
        print("[*] Execute novamente quando estiver com o Nmap pronto.")
    except KeyboardInterrupt:
        print("\n[*] Operação cancelada pelo operador.")
    finally:
        server.close()

if __name__ == "__main__":
    main()
