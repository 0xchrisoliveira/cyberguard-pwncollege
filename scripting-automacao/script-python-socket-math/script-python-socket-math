def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help"):
        show_lesson("Manual de ajuda solicitado pelo operador.")
        sys.exit(0)

    print(BANNER)
    print("=" * 80)
    print("   OPERAÇÃO HIGH-SPEED INTERCEPTOR — DESAFIO DE VELOCIDADE OPERACIONAL")
    print("=" * 80)
    print("[*] Regra: Você deve responder 10 perguntas matemáticas consecutivas.")
    print("[*] Janela de tempo: Máximo de 1.5 segundos por pergunta.")
    print("[*] Dica: Escreva um script em Python para ler e responder automaticamente.")
    print("-" * 80)
    sys.stdout.flush()

    total_rounds = 10
    time_limit = 1.5

    for i in range(1, total_rounds + 1):
        a = random.randint(10, 99)
        b = random.randint(10, 99)
        expected = a + b

        print(f"[{i}/{total_rounds}] Quanto e {a} + {b}? ", end="", flush=True)

        start_time = time.time()
        try:
            line = sys.stdin.readline()
            elapsed = time.time() - start_time
            if not line:
                show_lesson("Stream de entrada encerrado prematuramente.")
                sys.exit(1)
            resp = line.strip()
        except (KeyboardInterrupt, EOFError):
            print("\n[*] Interrompido pelo operador.")
            sys.exit(0)

        if elapsed > time_limit:
            show_lesson(
                f"TEMPO ESGOTADO na rodada {i}/{total_rounds}!\n"
                f"    Tempo decorrido: {elapsed:.2f}s (Limite: {time_limit}s).\n"
                f"    Velocidade humana insuficiente. Automatize a resolução via script!"
            )
            sys.exit(1)

        if resp != str(expected):
            show_lesson(
                f"Resposta incorreta na rodada {i}/{total_rounds}!\n"
                f"    Recebido: '{resp}' | Esperado: '{expected}' ({a} + {b})."
            )
            sys.exit(1)

    print("\n" + BANNER)
    print("[+] MISSÃO OPERACIONAL CUMPRIDA COM SUCESSO!")
    print(f"[+] Todas as {total_rounds} rodadas foram computadas dentro do tempo limite operacional.")
    print("[*] DEBRIEFING TÉCNICO:")
    print("    Você superou o limiar da latência humana utilizando automação com código.")
    print("    Em ataques modernos de Proof of Work (PoW), bypass de CAPTCHAs aritméticos,")
    print("    condições de corrida (Race Conditions) e CTFs de alta competitividade,")
    print("    a orquestração via sockets e subprocessos é uma arma indispensável.")
    print("[+] FLAG DE ACESSO AUTORIZADO LIBERADA:")
    print("-" * 60)
    print_flag()
    print("-" * 60)

if __name__ == "__main__":
    main()
