import sys
import os

BANNER = r"""
 ╔══════════════════════════════════════════════════════════════════════════════╗
 ║   ______      __                                   __                        ║
 ║  / ____/_  __/ /_  ___  _____ ____ ___  ______ _____/ /                        ║
 ║ / /   / / / / __ \/ _ \/ ___// __ `/ / / / __ `/ ___/ /_                       ║
 ║/ /___/ /_/ / /_/ /  __/ /   / /_/ / /_/ / /_/ / /  / __ \                      ║
