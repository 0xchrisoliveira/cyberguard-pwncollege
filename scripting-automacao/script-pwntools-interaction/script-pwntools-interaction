 ║     /____/                 /____/     CYBERGUARD OPERATIONAL PLATFORM 2026   ║
 ╚══════════════════════════════════════════════════════════════════════════════╝
"""

def print_flag():
    flag_path = "/flag"
    if os.path.exists(flag_path):
        try:
            with open(flag_path, "r", encoding="utf-8") as f:
                print(f.read().strip())
                return
        except Exception as e:
            print(f"[!] Erro ao ler /flag: {e}")
    print("pwn.college{cyberguard_pwntools_process_interaction_pwned_2026}")

def show_lesson(reason=None):
    print(BANNER)
    if reason:
        print(f"[-] AVISO OPERACIONAL: {reason}\n")
    print("=" * 80)
    print("   AULA DIDÁTICA: O FRAMEWORK PWNTOOLS E A ORQUESTRAÇÃO DE PROCESSOS IPC")
    print("=" * 80)
    print("""
1. O QUE É O PWNTOOLS?
   Desenvolvido pela comunidade internacional de segurança ofensiva e CTF, o
   'pwntools' é uma biblioteca em Python voltada para prototipagem rápida de exploits,
   manipulação de fluxos de entrada/saída (IPC / Sockets) e empacotamento de bytes.

2. POR QUE USAR PWNTOOLS EM VEZ DE DIGITAR MANUALMENTE?
   * Binários vulneráveis frequentemente exigem bytes nulos (\\x00), endereços de memória
     de 64 bits (little-endian) ou sincronismos milimétricos que um teclado não consegue enviar.
   * O Pwntools gerencia deadlocks de buffers e pipes automaticamente.

3. MÉTODOS FUNDAMENTAIS DO PWNTOOLS:
   * 'io = process("./binario")'       -> Dispara e anexa um processo local
   * 'io = remote("ip", porta)'        -> Conecta a um serviço de rede remoto
   * 'io.recvuntil(b"delimitador")'   -> Bloqueia e lê até encontrar a sequência de bytes
   * 'io.recvline()'                   -> Lê uma linha completa até o '\\n'
   * 'io.sendline(b"dados")'          -> Envia dados anexando '\\n' ao final
   * 'io.interactive()'                -> Devolve o controle do terminal ao operador

4. SCRIPT COMPLETO DE RESOLUÇÃO (solve_pwn.py):
   ------------------------------------------------------------------------
   from pwn import *

   # 1. Conecta ao executável
   io = process("/challenge/script-pwntools-interaction")

   # 2. Aguarda o token de prontidão emitido pelo binário
   io.recvuntil(b"CYBERGUARD_PWNTOOLS_READY")

   # 3. Envia a resposta de confirmação esperada
   io.sendline(b"CYBERGUARD_PWNTOOLS_OK")

   # 4. Recebe a resposta final com o debriefing e a flag
   print(io.recvall().decode("utf-8"))
   ------------------------------------------------------------------------

5. TESTE RÁPIDO ALTERNATIVO VIA SHELL (PIPE):
   $ echo "CYBERGUARD_PWNTOOLS_OK" | /challenge/script-pwntools-interaction
""")
    print("=" * 80)

def main():
    expected_token = "CYBERGUARD_PWNTOOLS_OK"

    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help"):
        show_lesson("Manual de ajuda solicitado pelo operador.")
        sys.exit(0)

    # Emitir sinal operacional de handshake no stdout e descarregar imediatamente
    print("CYBERGUARD_PWNTOOLS_READY")
    sys.stdout.flush()

    # Ler do stdin
    try:
        line = sys.stdin.readline()
        if not line:
            show_lesson("O stream stdin foi encerrado sem envio do token.")
            sys.exit(1)
        received = line.strip()
    except (KeyboardInterrupt, EOFError):
        print("\n[*] Interrompido pelo operador.")
        sys.exit(0)

    if received == expected_token:
        print("\n" + BANNER)
        print("[+] MISSÃO OPERACIONAL CUMPRIDA COM SUCESSO!")
        print(f"[+] Token de controle '{received}' recebido e validado com precisão.")
        print("[*] DEBRIEFING TÉCNICO:")
        print("    Você interagiu com sucesso com um processo local utilizando primitivas")
        print("    de IPC. Em exploração de binários (pwn), o pwntools é a ferramenta-padrão")
        print("    para orquestrar buffers de estouro (buffer overflow), montar ROP chains")
        print("    e injetar shellcodes em alvos locais e remotos.")
        print("[+] FLAG DE ACESSO AUTORIZADO LIBERADA:")
        print("-" * 60)
        print_flag()
        print("-" * 60)
    else:
        show_lesson(
            f"Resposta incorreta recebida: '{received}'.\n"
            f"    O protocolo requer o token de confirmação: '{expected_token}'."
        )
        sys.exit(1)

if __name__ == "__main__":
    main()
