#!/usr/bin/exec-suid -- /usr/local/bin/python -I
import sys, os, stat
target = "/tmp/config.conf"
if not os.path.exists(target):
    print("[X] Arquivo /tmp/config.conf nao encontrado! Crie-o primeiro.")
    sys.exit(1)
mode = oct(stat.S_IMODE(os.stat(target).st_mode))
if mode in ("0o640", "0640"):
    print("[+] Permissao 640 confirmada: Dono rw, Grupo r, Outros nada!")
    print(open("/flag").read() if os.path.exists("/flag") else "pwn.college{cyberguard_demo_flag}")
else:
    print(f"[X] Permissao incorreta: {mode}. O desafio exige exatamente 640.")
    print("[*] Dica: chmod 640 /tmp/config.conf")
    sys.exit(1)
