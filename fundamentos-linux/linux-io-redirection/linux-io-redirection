#!/usr/bin/exec-suid -- /usr/local/bin/python -I
import sys, os
line = sys.stdin.readline().strip()
if line == "CYBERGUARD_PIPELINE":
    print("[+] Redirecionamento I/O recebido com sucesso!")
    print(open("/flag").read() if os.path.exists("/flag") else "pwn.college{cyberguard_demo_flag}")
else:
    print("[X] Entrada invalida. Voce deve enviar 'CYBERGUARD_PIPELINE' via stdin.")
    print("[*] Exemplo: echo 'CYBERGUARD_PIPELINE' | /challenge/linux-io-redirection")
    sys.exit(1)
