#!/usr/bin/exec-suid -- /usr/local/bin/python -I
import sys, os
euid = os.geteuid()
print(f"[*] Seu Real UID: {os.getuid()} | Effective UID: {euid}")
if euid == 0:
    print("[+] Executando com privilegios de root via SUID!")
    print(open("/flag").read() if os.path.exists("/flag") else "pwn.college{cyberguard_demo_flag}")
else:
    print("[!] O binario precisa de privilegios root (verifique o bit SUID).")
    print(open("/flag").read() if os.path.exists("/flag") else "pwn.college{cyberguard_demo_flag}")
